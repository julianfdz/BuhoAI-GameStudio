#!/bin/sh
# buho-studio: CLI de Buho Game Studio (Git Bash, MSYS, WSL). Usa el ejecutable de la app en modo Node.
# Guia completa para agentes: buho-studio skill
dir=$(cd "$(dirname "$0")" && pwd)
script="$dir/buho-studio.mjs"
if command -v wslpath >/dev/null 2>&1; then script=$(wslpath -w "$script"); fi
ELECTRON_RUN_AS_NODE=1 exec "$dir/../BuhoGameStudio.exe" "$script" "$@"
