{
  "name": "buhoai-gamestudio",
  "productName": "Búho Game Studio",
  "version": "0.2.0",
  "description": "Búho Game Studio: la mesa de trabajo de un videojuego. Proyectos que son carpetas reales (como VS Code), contexto en Markdown, galería de assets con miniaturas y visor 3D, estados, comentarios, historial firmado, API local y CLI `buho-studio` para agentes. Independiente del motor. Buho Corps Systems.",
  "author": { "name": "Buho Corps Systems" },
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "bin": { "buho-studio": "bin/buho-studio.mjs" },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "electron-vite build && node e2e/smoke.mjs",
    "cli:instalar": "node scripts/instalar-cli.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "marked": "^16.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
